# Copy to .env and fill in. Never commit the real .env.

# --- Backend ---
PORT=8080
APP_ENV=development

# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5432/workout_tracker?sslmode=disable

# Generate a strong value for production, e.g. openssl rand -base64 48
JWT_SECRET=dev-insecure-secret-change-me
JWT_TTL=720h

# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Applies pending migrations on startup. Convenient in dev; in production you
# generally want this true so a deploy self-heals, or false if you migrate
# as a separate release step.
AUTO_MIGRATE=true